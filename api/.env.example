PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/mini_aws
DOCKER_SOCKET_PATH=/var/run/docker.sock
INSTANCE_IMAGE=mini-aws/ssh-instance:1.0.0
SSH_PUBLIC_HOST=localhost
INSTANCE_KEY_DIR=../instance-keys
CORS_ORIGIN=http://localhost:5173
# Set false only after replacing x-user-id dev identity with real JWT/session auth.
DEMO_AUTH=true
# Create a free Gemini API key in Google AI Studio. Keep this value server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
